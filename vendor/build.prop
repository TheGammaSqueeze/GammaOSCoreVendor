# GammaOS: permanent wireless adb (no pairing, legacy tcpip)
persist.adb.tcp.port=5555
# GammaOS: default USB composition = adb (adb-only gadget), set up for permanent wireless adb too
persist.vendor.usb.config=adb
# Dual-screen topology (hardware-natural primary):
#   PRIMARY  = DSI 1080p TOP panel  (port 130, local:4630947073007009410, HWC display 0)
#   SECONDARY= DP GH7005 BOTTOM panel(port 4,  local:4613330929536132356)
# The bottom panel is an INDEPENDENT secondary (not a mirror): the framework
# RRO vendor/overlay/RPDuoLiteFrameworkOverlay.apk sets
# config_localDisplaysMirrorContent=false so the secondary gets FLAG_OWN_CONTENT_ONLY,
# while FLAG_PRESENTATION stays set so games/apps can still project to it.
# Primary (top DSI, 1080x1920) presented as 1920x1080 landscape.
ro.surface_flinger.primary_display_orientation=ORIENTATION_90
# Touch->display mapping (verified). Top digitizer (himax) to the primary (display 0);
# bottom digitizer (fts_ts) to the secondary (display 1). Logical-id form is used because
# uniqueId/type forms miss these panels. himax rotated 90 to match the landscape top panel.
persist.gif.map.himax_touchscreen=0
persist.gif.rot.himax_touchscreen=90
persist.gif.map.fts_ts=1
# --- Deterministic dual-panel pinning (framework + SF patches) ---
# Pin the framework DEFAULT_DISPLAY to the panel on this physical port regardless of
# boot-time connector enumeration order (LocalDisplayAdapter). 130 = DSI top panel.
persist.gammaos.primary_port=130
# Per-physical-port physical orientation, applied to BOTH primary and secondary so a
# panel's orientation never depends on which display SF calls primary (SurfaceFlinger
# getPhysicalDisplayOrientation). Top DSI (port 130) landscape; bottom DP (port 4) native.
persist.gsf.port_rot.130=ORIENTATION_90
persist.gsf.port_rot.4=ORIENTATION_0
# GammaOS nano routes the launcher/XMB to the top panel (port 130).
persist.gammaos.nano.primary_display=130
# Nano DRM-direct mode: the top DSI panel needs a horizontal flip to read upright
# (the bottom DP uses its own matrix, default 0deg native landscape).
persist.gammaos.nano.drm_flip_h=1
# Route DS ROM launches to the drastic-nano binary (renders both DS screens through
# nano's DRM dual-panel path) instead of the com.dsemu.drastic APK, whose Dual-Stack
# tall-canvas mode assumes two identical stacked panels and goes blank here.
persist.gammaos.nano.drastic_nano=1
# The DSI and DP panels run on unlocked vblank clocks: present each CRTC on its
# own cadence (pace on the top DSI, flip the DP as soon as its previous flip
# lands) instead of gating every frame on both vblanks.
persist.gammaos.nano.drm_indep_flip=1
# The DRM home returns after a drastic-nano session launched from the overlay.
persist.gammaos.nano.drm_home_resume=1
# The DRM home keeps probing for the DP bottom panel until both panels are lit (its
# HPD arrives ~7 s after the bridge is powered, past the fixed 60 s window on slow boots).
persist.gammaos.nano.drm_displays=2
# drastic-nano defaults, mirroring the RG DS tuned set. Low Latency ships OFF here: its
# combined blocking commit anchors the loop to the DP bottom panel and its one-slot
# secondary delay is a frame of bottom-screen lag (the phase trick is for the RG DS twin
# DSI panels). Shader Per Screen on: the two panels differ in size, so each DS screen
# runs the shader at its own on-panel size. Every row is user-changeable in the game menu.
persist.gammaos.drastic_nano.autoload=1
persist.gammaos.drastic_nano.drm_half_res=0
persist.gammaos.drastic_nano.fps_counter=0
persist.gammaos.drastic_nano.frame_sync=0
persist.gammaos.drastic_nano.frameskip=0
persist.gammaos.drastic_nano.hires3d=1
persist.gammaos.drastic_nano.low_latency=0
persist.gammaos.drastic_nano.shader=4xLCD_Subpixel
persist.gammaos.drastic_nano.drm_screen_shader=1
# Built-in microphone: the codec capture gain is raised in mixer_paths_idp.xml (104); the
# noise gate in drastic-nano (High) and its mic level (1) were chosen with it by ear. The
# mic_level_v2 marker keeps drastic-nano's one-time reset of mic_level from undoing this.
persist.gammaos.drastic_nano.mic_gate=3
persist.gammaos.drastic_nano.mic_level=1
persist.gammaos.drastic_nano.mic_level_v2=1
# AAudio MMAP / EXCLUSIVE, as on the RG DS. The Qualcomm HAL declares an
# mmap_no_irq_out mix port (48 kHz stereo), so an EXCLUSIVE low-latency client such as
# drastic-nano bypasses the mixer. 2 is AUTO: try mmap, fall back to the legacy path.
aaudio.mmap_policy=2
aaudio.mmap_exclusive_policy=2
aaudio.hw_burst_min_usec=2000
# Bottom-screen control centre while a single-screen SurfaceFlinger app runs on
# the top panel. The top DSI is logical display 0 here (the RG DS default is 2).
persist.gammaos.nano.ps3xmb.controlcenter=1
persist.gammaos.nano.cc.topdisplay=0
# Control centre brightness sliders: panel0 is the top DSI, panel1 the bottom DP.
persist.gammaos.nano.cc.bl_top=panel0-backlight
persist.gammaos.nano.cc.bl_bottom=panel1-backlight
persist.gammaos.nano.cc.bottomdisplay=1
# The control centre reads the bottom DP digitizer directly (RG DS default gt9xx-0).
persist.gammaos.nano.cc.touchdev=fts_ts
# Per-display (top app / bottom app) media volume, as on the RG DS.
persist.gammaos.audio.multivolume=true
# Split brightness slot d1 is the BOTTOM panel here (the top on the RG DS).
persist.gammaos.nano.cc.d1_is_top=0
# Framework split brightness slots: d0 = top DSI, d1 = bottom DP (MCU-driven).
persist.gammaos.multidisplay.split_brightness.d0.path=/sys/class/backlight/panel0-backlight
persist.gammaos.multidisplay.split_brightness.d1.path=/sys/class/backlight/panel1-backlight
persist.gammaos.multidisplay.split_brightness.d0.min=1
persist.gammaos.multidisplay.split_brightness.d0.max=255
persist.gammaos.multidisplay.split_brightness.d1.min=1
persist.gammaos.multidisplay.split_brightness.d1.max=255
# Enable the GammaOS secondary display (independent bottom panel + its home). The bottom
# shows the secondary home and games/apps can project to it.
persist.gammaos.secondary_display.enabled=1
persist.gammaos.multidisplay.secondary_display=1
persist.gammaos.multidisplay.dual_focus=1
