# --- GammaOS Nano slide/hall wake (Anbernic RG Rotate, Unisoc T618) ---
# The hall is wired as an EV_SW SW_TABLET_MODE switch on the EIC async bank so it
# can wake the SoC out of deep S3. Pairs with: the async settle-poll
# gpio-eic-sprd.ko baked into vendor_boot, the eic_async SW_TABLET_MODE dtbo, and
# the wakelock-debounce PhoneWindowManager build. Replaces the old KEY_F12 /
# eic_debounce config. wake_debounce_ms=1000 requires the wakelock-debounce
# framework (holds the CPU awake across the debounce so the wake survives the
# deep-sleep re-suspend); set 0 for immediate wake if running without it.
persist.gammaos.rotate.enabled=1
persist.gammaos.rotate.key_type=5
persist.gammaos.rotate.key_code=1
persist.gammaos.rotate.key_active=1
persist.gammaos.rotate.dev_name=gpio-keys
persist.gammaos.rotate.down_action=rotate,screenoff
persist.gammaos.rotate.up_action=natural,wake
persist.gammaos.rotate.degrees=90
persist.gammaos.rotate.sleep_delay=15
persist.gammaos.rotate.wake_debounce_ms=1000

# GammaOS: KEY_F10 short-press toggles the left DPAD / left-analog-stick swap (gammapad
# custom button-action). dpadswap flips persist.gammaos.gamepad.analog_to_dpad and
# dpad_to_analog together and bumps config_version, identical to the SystemUI DPAD/Analog
# Swap tile. Shipped as act0 (act_count=1); any user rules added from the gammapad UI append
# after it and raise act_count. hold=0 => fires once on each short press (autorepeat suppressed).
persist.gammaos.gamepad.act_count=1
persist.gammaos.gamepad.act0_code=68
persist.gammaos.gamepad.act0_hold=0
persist.gammaos.gamepad.act0_s=dpadswap=

persist.gammaos.nano.drastic_nano=1
persist.gammaos.nano.ps3xmb=1
persist.gammaos.nano.overlay=1
persist.bootanim.skip_nano=0
persist.gammaos.ultra_low_power_saving_mode=1
persist.gammaos.gamepad.ff_vibrate_device=sc27xx:vibrator
