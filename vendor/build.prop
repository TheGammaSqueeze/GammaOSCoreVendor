# ---------------------------------------------------------------------------
# GammaOS (Retroid Pocket Duo)
# ---------------------------------------------------------------------------
# GammaOS device id (OTA endpoint, screen calibration profile)
ro.gammaos.device=retroidpocketduo

# Permanent wireless adb (no pairing, legacy tcpip)
persist.adb.tcp.port=5555
# Default USB composition = adb only. Stock asks for diag,adb, which sends the
# gadget HAL through a reconfiguration that dropped adb here.
persist.vendor.usb.config=adb

# Dual-screen topology (both panels are DSI):
#   PRIMARY   = top    vtdr6130 AMOLED 1080x1920, port 146 (portrait, mounted landscape)
#   SECONDARY = bottom xingxing 4.5" 1280x960,     port 147 (native landscape)
# Stock sets persist.panel.orientation=90 for the top panel.
ro.surface_flinger.primary_display_orientation=ORIENTATION_90
# Pin the framework DEFAULT_DISPLAY to the top panel whatever the connector
# enumeration order (LocalDisplayAdapter).
persist.gammaos.primary_port=146
# Per-port physical orientation, applied whichever display SurfaceFlinger calls
# primary: top landscape, bottom native.
persist.gsf.port_rot.146=ORIENTATION_90
persist.gsf.port_rot.147=ORIENTATION_0
# Touch to display mapping, from the stock input-port-associations.xml
# (port 146 = fts_ts, port 147 = fts_ts_sec): the top digitizer to the primary
# (display 0) rotated with the panel, the bottom digitizer to the secondary.
persist.gif.map.fts_ts=0
persist.gif.rot.fts_ts=90
persist.gif.map.fts_ts_sec=1

# Boot into GammaOS Nano (0 = nano home, 1 = full Android) with the 3DS theme as
# the home (ndstheme 4) and the XMB-style category layout underneath.
persist.bootanim.skip_nano=0
persist.gammaos.nano.ndstheme=4
persist.gammaos.nano.xmb_mode=1
persist.gammaos.nano.ps3xmb=1
# GammaOS nano routes the launcher/XMB to the top panel. The value is the CRTC
# enumeration index (0 = the top panel's CRTC), not a port number.
persist.gammaos.nano.primary_display=0
# Route DS ROM launches to drastic-nano (both DS screens through nano's DRM
# dual-panel path).
persist.gammaos.nano.drastic_nano=1
# Present each CRTC on its own cadence instead of gating every frame on both
# vblanks.
persist.gammaos.nano.drm_indep_flip=1
# The DRM home returns after a drastic-nano session launched from the overlay.
persist.gammaos.nano.drm_home_resume=1
# The DRM home waits for both panels.
persist.gammaos.nano.drm_displays=2
# Nano DRM-direct mode: the top panel needs a horizontal flip to read upright,
# as on the Duo Lite. Nano flips in the panel's portrait frame, so drm_flip_h
# mirrors the landscape picture top to bottom and drm_flip_v left to right.
# Nano reads these at its DRM setup, before /data's persistent props load, so
# only this build.prop value counts there.
persist.gammaos.nano.drm_flip_h=1
# Top panel digitizer (fts_ts, portrait) to the landscape logical frame for the
# raw-evdev DRM readers (nano home, drastic-nano), checked on the device: axes
# swapped, then the logical y flipped (the same as the Duo Lite's top digitizer).
persist.gammaos.nano.osk_touch_swap=1
persist.gammaos.nano.osk_touch_flipx=0
persist.gammaos.nano.osk_touch_flipy=1

# drastic-nano defaults as tuned on the Duo Lite, whose panels have the same
# sizes (every row is user-changeable in the game menu).
persist.gammaos.drastic_nano.backend=drm
persist.gammaos.drastic_nano.autoload=1
persist.gammaos.drastic_nano.drm_half_res=0
persist.gammaos.drastic_nano.fps_counter=0
persist.gammaos.drastic_nano.frame_sync=0
persist.gammaos.drastic_nano.frameskip=0
persist.gammaos.drastic_nano.frameskip_type=0
persist.gammaos.drastic_nano.hires3d=1
persist.gammaos.drastic_nano.gpu3d=0
persist.gammaos.drastic_nano.gpu3d_ss=1
persist.gammaos.drastic_nano.low_latency=0
persist.gammaos.drastic_nano.present_age_default=0
persist.gammaos.drastic_nano.zero_copy=0
persist.gammaos.drastic_nano.fast_input_always=1
persist.gammaos.drastic_nano.shader=2xPrescaleFast_LCD
persist.gammaos.drastic_nano.scaling=stretch
persist.gammaos.drastic_nano.screen_gap=0
persist.gammaos.drastic_nano.ff_limit=0
persist.gammaos.drastic_nano.drm_screen_fit=1
persist.gammaos.drastic_nano.drm_top_scale=93.9
persist.gammaos.drastic_nano.drm_bottom_scale=0
persist.gammaos.drastic_nano.drm_screen_shader=1
persist.gammaos.drastic_nano.ltune_dx=0
persist.gammaos.drastic_nano.ltune_dy=0
persist.gammaos.drastic_nano.ltune_scale=100
persist.gammaos.drastic_nano.crash_tombstone=1

# azahar-nano defaults as tuned on the Duo Lite (same panel sizes). No bundled
# GPU driver: the Lite's Turnip build is for its Adreno 610.
persist.gammaos.azahar_nano.pace_offset=1
persist.gammaos.azahar_nano.jit_save_bg=1
persist.gammaos.azahar_nano.backend=drm
persist.gammaos.azahar_nano.drm_upright=1
persist.gammaos.azahar_nano.drm_deadline=1
persist.gammaos.azahar_nano.drm_waitfence=1
persist.gammaos.azahar_nano.drm_blocking=0
persist.gammaos.azahar_nano.drm_fifo=0
persist.gammaos.azahar_nano.drm_nofence=0
persist.gammaos.azahar_nano.drm_postflip_us=0
persist.gammaos.azahar_nano.drm_core_tight=0
persist.gammaos.azahar_nano.tweaks=1
persist.gammaos.azahar_nano.fs_mediump=1
persist.gammaos.azahar_nano.light_skip=1
persist.gammaos.azahar_nano.shadow_gather=1
persist.gammaos.azahar_nano.dynres=1
persist.gammaos.azahar_nano.resolution_factor=1.5
persist.gammaos.azahar_nano.render_scale_top=100
persist.gammaos.azahar_nano.render_scale_bottom=100
persist.gammaos.azahar_nano.build_order=lifo
persist.gammaos.azahar_nano.jit_unsafe=0
persist.gammaos.azahar_nano.async_gpu=0
persist.gammaos.azahar_nano.pipe_workers=0
persist.gammaos.azahar_nano.pipe_noopt=0
persist.gammaos.azahar_nano.lut_ssbo=0
persist.gammaos.azahar_nano.ubwc=0
persist.gammaos.azahar_nano.uber_strip=0
persist.gammaos.azahar_nano.stereo_skip=0
persist.gammaos.azahar_nano.lcd_top=4
persist.gammaos.azahar_nano.lcd_bottom=4
persist.gammaos.azahar_nano.screen_aa=0
persist.gammaos.azahar_nano.fps_counter=0
persist.gammaos.azahar_nano.compile_notice=1
persist.gammaos.azahar_nano.stick_dpad_swap=0

# Bottom-screen control centre while a single-screen SurfaceFlinger app runs on
# the top panel (the top panel is logical display 0).
persist.gammaos.nano.ps3xmb.controlcenter=1
persist.gammaos.nano.cc.topdisplay=0
persist.gammaos.nano.cc.bottomdisplay=1
# Control centre brightness sliders: panel0 is the top panel, panel1 the bottom.
persist.gammaos.nano.cc.bl_top=panel0-backlight
persist.gammaos.nano.cc.bl_bottom=panel1-backlight
# The control centre reads the bottom digitizer directly; the top digitizer is
# used for tap-to-focus between the top and bottom apps.
persist.gammaos.nano.cc.touchdev=fts_ts_sec
persist.gammaos.nano.cc.topdev=fts_ts
# The pad's mode button (BTN_MODE, 316) shows and hides the Control Center over
# the app on the bottom screen.
persist.gammaos.nano.cc.keycode=316

# GammaOS gamepad (gammapad): the built-in Retroid Pocket Controller merged into
# the virtual Xbox pad, the source device hidden from apps, a full reload on a
# config change.
persist.gammaos.gamepad.enable=1
persist.gammaos.gamepad.merge=1
persist.gammaos.gamepad.hide_source=1
persist.gammaos.gamepad.full_reload=1
persist.gammaos.gamepad.devices=Retroid Pocket Controller

# Per-display (top app / bottom app) media volume.
persist.gammaos.audio.multivolume=true
# Split brightness: slot d0 = top panel, d1 = bottom panel. The max values are
# read from the panels at boot by gammaos_backlight_props.sh (the top panel's is
# 8191, not 255).
persist.gammaos.nano.cc.d1_is_top=0
persist.gammaos.multidisplay.split_brightness.d0.path=/sys/class/backlight/panel0-backlight
persist.gammaos.multidisplay.split_brightness.d1.path=/sys/class/backlight/panel1-backlight
persist.gammaos.multidisplay.split_brightness.d0.min=1
persist.gammaos.multidisplay.split_brightness.d1.min=1

# GammaOS secondary display: the bottom panel is independent, shows the
# secondary home, and games/apps can project to it.
persist.gammaos.secondary_display.enabled=1
persist.gammaos.multidisplay.secondary_display=1
persist.gammaos.multidisplay.dual_focus=1

# Quick settings tiles: default pages and the tiles hidden on this device
persist.gammaos.qs.override_default_tiles_0=internet,bt,performance,gammasplitbrightness
persist.gammaos.qs.override_default_tiles_1=gammasecondarydisplay,gammashader,rotation,gammaeq,immersivemode
persist.gammaos.qs.override_default_tiles_2=secondarydisplayapps,launchguard,gammadualfocus,abxy
