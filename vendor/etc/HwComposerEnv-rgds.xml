<?xml version="1.0" encoding="utf-8"?>
<HwComposerEnv Version="1.2.0" Enable="1">
  <!-- SplitMode: one 640x960 framebuffer split vertically over two 640x480 DSI panels -->
  <DsiplayMode Mode="1" FbWidth="640" FbHeight="960">
    <!-- Top panel: DSI-2 shows [0,0,640,480] -->
    <Connector>
      <Type>DSI</Type>
      <TypeId>2</TypeId>
      <SrcX>0</SrcX>
      <SrcY>0</SrcY>
      <SrcW>640</SrcW>
      <SrcH>480</SrcH>
      <DstX>0</DstX><DstY>0</DstY><DstW>0</DstW><DstH>0</DstH>
      <Transform>0</Transform>
      <Primary>1</Primary>
      <Extend>0</Extend>
    </Connector>

    <!-- Bottom panel: DSI-1 shows [0,480,640,480] -->
    <Connector>
      <Type>DSI</Type>
      <TypeId>1</TypeId>
      <SrcX>0</SrcX>
      <SrcY>480</SrcY>
      <SrcW>640</SrcW>
      <SrcH>480</SrcH>
      <DstX>0</DstX><DstY>0</DstY><DstW>0</DstW><DstH>0</DstH>
      <Transform>0</Transform>
      <Primary>1</Primary>
      <Extend>0</Extend>
    </Connector>
  </DsiplayMode>
</HwComposerEnv>




