<?xml version="1.0" encoding="UTF-8"?>
<tlog>

  <!-- Only the size of the persist log will be limited -->
  <Config name="limits">
    <enable>true</enable>
    <!-- MB. The maximum space used by all log files. -->
    <!-- If used space of all log files more than maxUsedSpace,
     the oldest files will be deleted until less than maxUsedSpace. -->
    <maxUsedSpaceMb>300</maxUsedSpaceMb>
    <!-- MB. The minimum remaining space on the device. -->
    <!-- If the remaining space of the device is less than minFreeSapce,
     the oldest file will be deleted until greater than minFreeSapce. -->
    <minFreeSapceMb>200</minFreeSapceMb>
  </Config>

  <Config logtype="persist">
    <!-- enable persist log after boot completed. -->
    <enable>true</enable>
    <!-- If you modify the save path, you need to confirm whether have write permission. -->
    <savePath>/data/vendor/tlog/persist/</savePath>
    <!-- The index of the log files will be from 0 to maxFileCount. -->
    <maxFileCount>200</maxFileCount>
    <!-- KB -->
    <perFileSizeKb>10240</perFileSizeKb>
    <!-- Encrypt each log file if true. -->
    <encrypt>false</encrypt>
    <!-- encryptKey: 16bits, "lenovo"'s md5 -->
    <encryptKey>c2b3beb2a9a00ad2</encryptKey>
    <!-- Compress each log file if true. -->
    <zip>false</zip>
    <!-- If true, the oldest file will be deleted when the index of the log file exceeds maxFileCount. -->
    <rotate>true</rotate>
    <!-- What kind of android logs -->
    <subType>main,system,crash,radio,kernel,events</subType>
    <!-- The following logs will be output to its own file. -->
    <logToFile>kernel</logToFile>
  </Config>

  <Config logtype="manual">
    <enable>true</enable>
    <savePath>/data/vendor/tlog/manual/</savePath>
    <maxFileCount>50</maxFileCount>
    <perFileSizeKb>256</perFileSizeKb>
    <encrypt>false</encrypt>
    <encryptKey>c2b3beb2a9a00ad2</encryptKey>
    <zip>false</zip>
    <rotate>true</rotate>
    <subType>main,system,crash,radio,kernel,events</subType>
    <logToFile>kernel</logToFile>
  </Config>

  <Config logtype="fatal">
    <enable>true</enable>
    <savePath>/data/tlog/fatal/</savePath>
  </Config>

  <Config logtype="bluetooth">
    <enable>true</enable>
    <savePath>/data/tlog/bluetooth/</savePath>
  </Config>

  <Config logtype="tzlog">
    <enable>true</enable>
    <savePath>/data/vendor/tlog/tzlog/</savePath>
  </Config>

  <Config logtype="qxdm">
    <enable>true</enable>
    <savePath>/data/vendor/tlog/qxdm/</savePath>
    <arg>-n 5 -s 100 -c</arg>
  </Config>

</tlog>
