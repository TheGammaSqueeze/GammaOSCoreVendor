on boot
    wait /dev/vha0
    chown system system /dev/vha0
    chmod 666 /dev/vha0

service unisoc-nn-hal-shim-service /vendor/bin/hw/android.hardware.neuralnetworks-shim-unisoc-nn-service
    interface aidl android.hardware.neuralnetworks.IDevice/unisoc-npu
    class hal
    user system
    group system
    setenv IMG_HAL_PARAMS "-h /vendor/etc/npu_img_hwconfig.json -m /vendor/etc/npu_img_mapconfig.json"
    disabled
    oneshot
