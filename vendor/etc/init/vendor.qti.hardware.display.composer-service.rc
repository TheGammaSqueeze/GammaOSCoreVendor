service vendor.qti.hardware.display.composer /vendor/bin/hw/vendor.qti.hardware.display.composer-service
    class hal animation
    user system
    group graphics drmrpc
    # GammaOS: libgammaos_drmmaster takes DRM master transiently around each
    # mode-setting ioctl so the composer presents again after the nano home or
    # drastic-nano hand the panel back (the stock composer never calls
    # SET_MASTER and goes black for the session). SET_MASTER on a file that was
    # never master needs CAP_SYS_ADMIN.
    setenv LD_PRELOAD /vendor/lib64/libgammaos_drmmaster.so
    capabilities SYS_NICE SYS_ADMIN
    onrestart restart surfaceflinger
    socket pps stream 0660 system system
    writepid /dev/cpuset/system-background/tasks
