# GammaOS I/O tuning for MagicX zero40 (A133P, SD card).

on init
    write /sys/block/mmcblk0/queue/scheduler noop
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    write /sys/block/mmcblk0/queue/rq_affinity 2
    # Cap zram physical RAM usage before swapon runs. 256MB (raised from 200MB at the
    # user's request for more game-launch headroom; AM2R drove zram to ~157MB of the old
    # 200MB cap at only ~2.1:1 on game anon). Trade-off: zsmalloc pages are unswappable
    # kernel RAM, so this hands ~56MB more physical RAM to zram and away from working sets;
    # ~256MB is the practical ceiling on this 1GB device. Below ~146MB zs_malloc fails at
    # order:0 under load.
    write /sys/block/zram0/mem_limit 268435456

on early-fs
    write /proc/sys/vm/page-cluster 0
    # GammaOS Nano: swap aggressively to the lz4 zram (fast, in-RAM, and mostly
    # empty - it was ~16% used when lmkd killed a foreground game). swappiness 30
    # throttled anon reclaim, so under a launch spike the kernel stalled and lmkd
    # killed the adj-0 app instead of swapping. 100 = prefer zram over killing.
    write /proc/sys/vm/swappiness 100
    # Proactive reclaim (root-cause fix): widen the kernel watermark band so kswapd drains
    # cold anon to the idle zram ASYNCHRONOUSLY before a launch burst punches MIN and forces
    # synchronous direct reclaim, which spikes PSI_FULL and makes lmkd (mp_event_common,
    # eligible to kill down to adj 0) reap the foreground app while ~454MB of zram sits unused.
    # 4.9.170 kernel: these three exist; watermark_boost_factor (5.0+) does NOT. This file is
    # the SOLE writer of every vm/* tunable to avoid a nondeterministic last-writer race.
    write /proc/sys/vm/watermark_scale_factor 100
    write /proc/sys/vm/min_free_kbytes 24576
    write /proc/sys/vm/extra_free_kbytes 16384
    write /proc/sys/vm/vfs_cache_pressure 100
    write /proc/sys/vm/dirty_writeback_centisecs 3000
    write /proc/sys/vm/dirty_expire_centisecs 3000
    write /proc/sys/vm/dirty_ratio 10
    write /proc/sys/vm/dirty_background_ratio 3

on property:sys.boot_completed=1
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/watermark_scale_factor 100
    write /proc/sys/vm/min_free_kbytes 24576
    write /proc/sys/vm/extra_free_kbytes 16384
    write /proc/sys/vm/vfs_cache_pressure 100
    write /proc/sys/vm/dirty_writeback_centisecs 3000
    write /proc/sys/vm/dirty_expire_centisecs 3000
    write /proc/sys/vm/dirty_ratio 10
    write /proc/sys/vm/dirty_background_ratio 3
