on property:sys.performance.enabled=1
    #=== GPU boost ===
    write /sys/class/kgsl/kgsl-3d0/force_rail_on 1
    write /sys/class/kgsl/kgsl-3d0/force_bus_on 1
    write /sys/class/kgsl/kgsl-3d0/force_clk_on 1
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 0
    write /sys/class/kgsl/kgsl-3d0/hwcg 0
    write /sys/class/kgsl/kgsl-3d0/idle_timer 10000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor performance
    #=== CPU boost ===
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor performance
    #=== eMMC CLK boost ===
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/dm-0/queue/read_ahead_kb 2048
    write /sys/block/dm-1/queue/read_ahead_kb 2048
    write /sys/block/dm-2/queue/read_ahead_kb 2048
    write /sys/block/dm-3/queue/read_ahead_kb 2048
    write /sys/block/dm-4/queue/read_ahead_kb 2048
    write /sys/block/dm-5/queue/read_ahead_kb 2048
    write /sys/block/dm-6/queue/read_ahead_kb 2048
    write /sys/block/dm-7/queue/read_ahead_kb 2048
    write /sys/block/dm-8/queue/read_ahead_kb 2048
    write /sys/block/dm-9/queue/read_ahead_kb 2048
    write /sys/block/dm-10/queue/read_ahead_kb 2048
    write /sys/block/dm-11/queue/read_ahead_kb 2048
    write /sys/block/dm-12/queue/read_ahead_kb 2048
    write /sys/block/dm-13/queue/read_ahead_kb 2048
    write /sys/block/dm-15/queue/read_ahead_kb 2048
    write /sys/block/dm-16/queue/read_ahead_kb 2048
    write /sys/block/dm-17/queue/read_ahead_kb 2048
    write /sys/block/dm-20/queue/read_ahead_kb 2048
    write /sys/block/dm-21/queue/read_ahead_kb 2048
    write /sys/block/dm-22/queue/read_ahead_kb 2048
    write /sys/block/dm-26/queue/read_ahead_kb 2048
    write /sys/block/dm-27/queue/read_ahead_kb 2048
    write /sys/block/dm-28/queue/read_ahead_kb 2048
    write /sys/block/dm-29/queue/read_ahead_kb 2048
    write /sys/block/dm-30/queue/read_ahead_kb 2048
    write /sys/block/dm-34/queue/read_ahead_kb 2048
    write /sys/block/dm-36/queue/read_ahead_kb 2048
    write /sys/block/dm-37/queue/read_ahead_kb 2048
    write /sys/block/dm-38/queue/read_ahead_kb 2048
    write /sys/block/dm-39/queue/read_ahead_kb 2048
    write /sys/block/dm-40/queue/read_ahead_kb 2048
    write /sys/block/dm-42/queue/read_ahead_kb 2048
    write /sys/block/dm-43/queue/read_ahead_kb 2048
    write /sys/block/dm-46/queue/read_ahead_kb 2048
    write /sys/block/dm-50/queue/read_ahead_kb 2048
    write /sys/block/dm-51/queue/read_ahead_kb 2048
    #=== Stop Thermal ===
    stop thermal-engine
    stop thermal

on property:sys.performance.enabled=0
    #=== GPU Normally ===
    write /sys/class/kgsl/kgsl-3d0/force_rail_on 0
    write /sys/class/kgsl/kgsl-3d0/force_bus_on 0
    write /sys/class/kgsl/kgsl-3d0/force_clk_on 0
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 6
    write /sys/class/kgsl/kgsl-3d0/hwcg 1
    write /sys/class/kgsl/kgsl-3d0/idle_timer 80
    write /sys/class/kgsl/kgsl-3d0/devfreq/governor msm-adreno-tz
    #=== CPU Normally ===
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor walt
    #=== eMMC CLK Normally ===
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    write /sys/block/mmcblk0/queue/nr_requests 32
    write /sys/block/dm-0/queue/read_ahead_kb 512
    write /sys/block/dm-1/queue/read_ahead_kb 512
    write /sys/block/dm-2/queue/read_ahead_kb 512
    write /sys/block/dm-3/queue/read_ahead_kb 512
    write /sys/block/dm-4/queue/read_ahead_kb 512
    write /sys/block/dm-5/queue/read_ahead_kb 512
    write /sys/block/dm-6/queue/read_ahead_kb 512
    write /sys/block/dm-7/queue/read_ahead_kb 512
    write /sys/block/dm-8/queue/read_ahead_kb 512
    write /sys/block/dm-9/queue/read_ahead_kb 512
    write /sys/block/dm-10/queue/read_ahead_kb 512
    write /sys/block/dm-11/queue/read_ahead_kb 512
    write /sys/block/dm-12/queue/read_ahead_kb 512
    write /sys/block/dm-13/queue/read_ahead_kb 512
    write /sys/block/dm-15/queue/read_ahead_kb 512
    write /sys/block/dm-16/queue/read_ahead_kb 512
    write /sys/block/dm-17/queue/read_ahead_kb 512
    write /sys/block/dm-20/queue/read_ahead_kb 512
    write /sys/block/dm-21/queue/read_ahead_kb 512
    write /sys/block/dm-22/queue/read_ahead_kb 512
    write /sys/block/dm-26/queue/read_ahead_kb 512
    write /sys/block/dm-27/queue/read_ahead_kb 512
    write /sys/block/dm-28/queue/read_ahead_kb 512
    write /sys/block/dm-29/queue/read_ahead_kb 512
    write /sys/block/dm-30/queue/read_ahead_kb 512
    write /sys/block/dm-34/queue/read_ahead_kb 512
    write /sys/block/dm-36/queue/read_ahead_kb 512
    write /sys/block/dm-37/queue/read_ahead_kb 512
    write /sys/block/dm-38/queue/read_ahead_kb 512
    write /sys/block/dm-39/queue/read_ahead_kb 512
    write /sys/block/dm-40/queue/read_ahead_kb 512
    write /sys/block/dm-42/queue/read_ahead_kb 512
    write /sys/block/dm-43/queue/read_ahead_kb 512
    write /sys/block/dm-46/queue/read_ahead_kb 512
    write /sys/block/dm-50/queue/read_ahead_kb 512
    write /sys/block/dm-51/queue/read_ahead_kb 512
    #=== Start Thermal ===
    start thermal-engine
    start thermal
