on post-fs-data
    mkdir /data/vendor/tlog 0777 system system encryption=Require
    restorecon /data/vendor/tlog
    mkdir /data/vendor/tlog/persist 0777 system system
    restorecon /data/vendor/tlog/persist
    mkdir /data/vendor/tlog/qxdm 0777 system system
    restorecon /data/vendor/tlog/qxdm
    mkdir /data/vendor/tlog/tzlog 0777 system system
    restorecon /data/vendor/tlog/tzlog
on property:ro.debuggable=1 && property:sys.boot_completed=1
    setprop persist.sys.tlog.active 1
on property:ro.debuggable=0 && property:sys.boot_completed=1
    setprop persist.sys.tlog.active 0

service tlogdPersist /vendor/bin/tlogd -p
    class main
    user system
    group system
    oom_score_adjust -900
    disabled

service tlogQxdmStart /vendor/bin/tlogd -q1
    class main
    oneshot
    disabled
    user system
    group system

service tlogQxdmStop /vendor/bin/tlogd -q0
    class main
    oneshot
    disabled
    user system
    group system

on property:persist.sys.tlog.active=1
    start tlogdPersist

on property:persist.sys.tlog.active=0
    stop tlogdPersist

on property:sys.tlog.qxdm.active=1
    start tlogQxdmStart

on property:sys.tlog.qxdm.active=0
    start tlogQxdmStop
