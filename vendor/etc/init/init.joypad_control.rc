service joypad_control_screen_off /system/bin/sh -c "echo 0 > /sys/devices/platform/singleadc-joypad/enable"
    class main
    user root
    group root system
    oneshot
    disabled

service joypad_control_screen_on /system/bin/sh -c "echo 1 > /sys/devices/platform/singleadc-joypad/enable; echo 1500 > /sys/devices/platform/singleadc-joypad/jokstick_cal_scale; echo 2 > /sys/devices/platform/singleadc-joypad/remapkey_xbox_switch_bt_tr"
    class main
    user root
    group root system
    oneshot
    disabled

service led_control_screen_on /vendor/bin/gammargb 960 720
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad /vendor/bin/gammapad retrogame_joypad --ffdev=sc27xx:vibrator --ffpwm
    class main
    user root
    group root system
    oneshot
    disabled

service led_control_off /system/bin/sh -c "echo 0 > /sys/devices/platform/singleadc-joypad/led_switch; echo 1 > /sys/devices/platform/singleadc-joypad/led_set"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_abxy_on /system/bin/sh -c "echo 1 > /data/GammaPad/ABXY_LAYOUT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_abxy_off /system/bin/sh -c "echo 0 > /data/GammaPad/ABXY_LAYOUT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_dpadanalogswap_on /system/bin/sh -c "echo 1 > /data/GammaPad/DPAD_ANALOG_SWAP"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_dpadanalogswap_off /system/bin/sh -c "echo 0 > /data/GammaPad/DPAD_ANALOG_SWAP"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_leftstickinvert_on /system/bin/sh -c "echo 1 > /data/GammaPad/LEFTSTICKINVERT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_leftstickinvert_off /system/bin/sh -c "echo 0 > /data/GammaPad/LEFTSTICKINVERT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_rightstickinvert_on /system/bin/sh -c "echo 1 > /data/GammaPad/RIGHTSTICKINVERT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_rightstickinvert_off /system/bin/sh -c "echo 0 > /data/GammaPad/RIGHTSTICKINVERT"
    class main
    user root
    group root system
    oneshot
    disabled

on property:sys.screen.state=off
    start joypad_control_screen_off
    stop led_control_screen_on

on property:sys.screen.state=on
    start joypad_control_screen_on

on property:sys.boot_completed=1
    start gammapad
    setprop sys.screen.state on

on property:persist.gammargb.control=off
    stop led_control_screen_on
    start led_control_off

on property:persist.gammargb.control=on && property:sys.screen.state=on
    start led_control_screen_on

on persist.gamma.abxyswap=1 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_abxy_on

on persist.gamma.abxyswap=0 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_abxy_off

on persist.gamma.dpadanalogswap=1 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_dpadanalogswap_on

on persist.gamma.dpadanalogswap=0 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_dpadanalogswap_off

on persist.gamma.leftstickinvert=1 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_leftstickinvert_on

on persist.gamma.leftstickinvert=0 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_leftstickinvert_off

on persist.gamma.rightstickinvert=1 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_rightstickinvert_on

on persist.gamma.rightstickinvert=0 && property:sys.boot_completed=1 && property:sys.screen.state=on
    start gammapad_rightstickinvert_off
