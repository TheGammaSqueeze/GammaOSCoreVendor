service joypad_control_screen_off /system/bin/sh -c "sleep 10; echo 0 > /sys/devices/platform/singleadc-joypad/enable"
    class main
    user root
    group root system
    oneshot
    disabled

service joypad_control_screen_on /system/bin/sh -c "sleep 0.5; echo 1 > /sys/devices/platform/singleadc-joypad/enable; echo 1500 > /sys/devices/platform/singleadc-joypad/jokstick_cal_scale; echo 2 > /sys/devices/platform/singleadc-joypad/remapkey_xbox_switch_bt_tr"
    class main
    user root
    group root system
    oneshot
    disabled

service led_control_screen_on /vendor/bin/gammargb
    class main
    user root
    group root system
    oneshot
    disabled

service led_control_off /system/bin/sh -c "sleep 0.5; echo 0 > /sys/devices/platform/singleadc-joypad/led_switch; echo 1 > /sys/devices/platform/singleadc-joypad/led_set"
    class main
    user root
    group root system
    oneshot
    disabled

on property:sys.screen.state=off
    start joypad_control_screen_off
    stop led_control_screen_on
    start led_control_off

on property:sys.screen.state=on
    stop joypad_control_screen_off
    start joypad_control_screen_on

on property:sys.boot_completed=1
    setprop sys.screen.state on
    start joypad_control_screen_on

on property:persist.gammargb.control=off
    stop led_control_screen_on
    start led_control_off

on property:persist.gammargb.control=on && property:sys.screen.state=on
    start led_control_screen_on
