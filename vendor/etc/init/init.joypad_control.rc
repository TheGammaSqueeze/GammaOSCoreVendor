service retroidpad /vendor/bin/retroidpad "Retroid Pocket Controller"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad /system/bin/sh -c "if [ ! -d /data/GammaPad ]; then mkdir -p /data/GammaPad && chmod 777 /data/GammaPad; fi; if [ ! -f /data/GammaPad/ffpwmmax ]; then echo 24000 > /data/GammaPad/ffpwmmax; fi; sleep 3; cmd vibrator_manager synced oneshot 100; /vendor/bin/gammapad 'Retroid Pocket Controller' --gasbrakeemulation --rpclassic --ffpwm"
    class main
    user root
    group root system
    oneshot
    disabled

service remove_retroidpad_event /vendor/bin/remove_retroidpad_event.sh
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_abxy_on /system/bin/sh -c "echo 1 > /data/GammaPad/ABXY_LAYOUT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_abxy_off /system/bin/sh -c "echo 0 > /data/GammaPad/ABXY_LAYOUT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_dpadanalogswap_on /system/bin/sh -c "echo 1 > /data/GammaPad/DPAD_ANALOG_SWAP"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_dpadanalogswap_off /system/bin/sh -c "echo 0 > /data/GammaPad/DPAD_ANALOG_SWAP"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_leftstickinvert_on /system/bin/sh -c "echo 1 > /data/GammaPad/LEFTSTICKINVERT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_leftstickinvert_off /system/bin/sh -c "echo 0 > /data/GammaPad/LEFTSTICKINVERT"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_rightstickinvert_on /system/bin/sh -c "echo 1 > /data/GammaPad/RIGHTSTICKINVERT_Z_RZ"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_rightstickinvert_off /system/bin/sh -c "echo 0 > /data/GammaPad/RIGHTSTICKINVERT_Z_RZ"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogsensitivity_off /system/bin/sh -c "echo 0 > /data/GammaPad/ANALOGSENSITIVITY"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogsensitivity_50 /system/bin/sh -c "echo -3 > /data/GammaPad/ANALOGSENSITIVITY"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogsensitivity_75 /system/bin/sh -c "echo -2 > /data/GammaPad/ANALOGSENSITIVITY"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogsensitivity_90 /system/bin/sh -c "echo -1 > /data/GammaPad/ANALOGSENSITIVITY"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogsensitivity_110 /system/bin/sh -c "echo 1 > /data/GammaPad/ANALOGSENSITIVITY"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogsensitivity_125 /system/bin/sh -c "echo 2 > /data/GammaPad/ANALOGSENSITIVITY"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogsensitivity_150 /system/bin/sh -c "echo 3 > /data/GammaPad/ANALOGSENSITIVITY"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogdeadzone_off /system/bin/sh -c "echo 0 > /data/GammaPad/DEADZONE"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogdeadzone_5 /system/bin/sh -c "echo 5 > /data/GammaPad/DEADZONE"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogdeadzone_10 /system/bin/sh -c "echo 10 > /data/GammaPad/DEADZONE"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogdeadzone_15 /system/bin/sh -c "echo 15 > /data/GammaPad/DEADZONE"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_analogdeadzone_20 /system/bin/sh -c "echo 20 > /data/GammaPad/DEADZONE"
    class main
    user root
    group root system
    oneshot
    disabled

service gammapad_calibration_on /system/bin/sh -c "echo 1 > /data/GammaPad/CALIBRATION_MODE; sleep 1; setprop persist.gammaos.calibrationmode 0"
    class main
    user root
    group root system
    oneshot
    disabled

service led_control_screen_on /system/bin/sh -c "echo 1 > /sys/class/sn3112l/led/enable; echo 1 > /sys/class/sn3112r/led/enable; sleep 1; /vendor/bin/gammargb --y-red=1.0 --y-green=0.6 --c-green=1.0 --c-blue=0.9 --m-red=1.0 --m-blue=0.2"
    class main
    user root
    group root system
    oneshot
    disabled

service led_control_off /system/bin/sh -c "echo 0 > /sys/class/sn3112l/led/enable; echo 0 > /sys/class/sn3112r/led/enable"
    class main
    user root
    group root system
    oneshot
    disabled

on post-fs-data
    start retroidpad

on property:sys.boot_completed=1
    start gammapad
    setprop sys.screen.state on
    start remove_retroidpad_event

on property:persist.gammargb.control=off
    stop led_control_screen_on
    start led_control_off

on property:persist.gammargb.control=on && property:sys.screen.state=on
    start led_control_screen_on

on property:persist.gammaos.abxyswap=on
    start gammapad_abxy_on

on property:persist.gammaos.abxyswap=off
    start gammapad_abxy_off

on property:persist.gammaos.dpadanalogswap=on
    start gammapad_dpadanalogswap_on

on property:persist.gammaos.dpadanalogswap=off
    start gammapad_dpadanalogswap_off

on property:persist.gammaos.leftstickinvert=on
    start gammapad_leftstickinvert_on

on property:persist.gammaos.leftstickinvert=off
    start gammapad_leftstickinvert_off

on property:persist.gammaos.rightstickinvert=on
    start gammapad_rightstickinvert_on

on property:persist.gammaos.rightstickinvert=off
    start gammapad_rightstickinvert_off

on property:persist.gammaos.analogsensitivity=0
    start gammapad_analogsensitivity_off

on property:persist.gammaos.analogsensitivity=-3
    start gammapad_analogsensitivity_50

on property:persist.gammaos.analogsensitivity=-2
    start gammapad_analogsensitivity_75

on property:persist.gammaos.analogsensitivity=-1
    start gammapad_analogsensitivity_90

on property:persist.gammaos.analogsensitivity=1
    start gammapad_analogsensitivity_110

on property:persist.gammaos.analogsensitivity=2
    start gammapad_analogsensitivity_125

on property:persist.gammaos.analogsensitivity=3
    start gammapad_analogsensitivity_150

on property:persist.gammaos.analogdeadzone=0
    start gammapad_analogdeadzone_0

on property:persist.gammaos.analogdeadzone=1
    start gammapad_analogdeadzone_5

on property:persist.gammaos.analogdeadzone=2
    start gammapad_analogdeadzone_10

on property:persist.gammaos.analogdeadzone=3
    start gammapad_analogdeadzone_15

on property:persist.gammaos.analogdeadzone=4
    start gammapad_analogdeadzone_20

on property:persist.gammaos.calibrationmode=1
    start gammapad_calibration_on

on shutdown
   stop gammapad
   stop retroidpad
