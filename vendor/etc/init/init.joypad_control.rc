service retroidpad /vendor/bin/retroidpad "Retroid Pocket Controller"
    class main
    user root
    group root system
    oneshot
    disabled

# post-fs, not post-fs-data: the pad needs only /dev/ttyHS1 and uinput (it
# retries the serial open), so it is up before the long first boot after a
# factory reset or a fresh install settles.
on post-fs
    start retroidpad

on shutdown
   stop retroidpad
