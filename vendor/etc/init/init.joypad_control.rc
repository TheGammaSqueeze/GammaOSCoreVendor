# /vendor/etc/init/init.joypad_control.rc

# Marker: confirms init parsed and loaded this file
on boot
    write /dev/kmsg "JOYRC: init.joypad_control.rc loaded"

service joypad_control_screen_off /system/bin/sh -c "sleep 1"
    class main
    user root
    group root system
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

service joypad_control_screen_on /system/bin/sh -c "sleep 1"
    class main
    user root
    group root system
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

service led_control_screen_on /vendor/bin/gammargb
    class main
    user root
    group root system
    seclabel u:r:gammargb:s0
    oneshot
    disabled

service led_control_off /system/bin/sh -c "echo 0 > /sys/devices/platform/odm/odm:rz_led@0/rzled_l; echo 0 > /sys/devices/platform/odm/odm:rz_led@0/rzled_r"
    class main
    user root
    group root system
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

# --- Triggers --------------------------------------------------------------

on property:sys.screen.state=off
    write /dev/kmsg "JOYRC: sys.screen.state=off"
    start joypad_control_screen_off
    stop led_control_screen_on
    start led_control_off

on property:sys.screen.state=on
    write /dev/kmsg "JOYRC: sys.screen.state=on"
    stop joypad_control_screen_off
    start joypad_control_screen_on

on property:sys.boot_completed=1
    write /dev/kmsg "JOYRC: sys.boot_completed=1"
    setprop sys.screen.state on

# LED control property
on property:persist.gammargb.control=off
    write /dev/kmsg "JOYRC: persist.gammargb.control=off"
    stop led_control_screen_on
    start led_control_off

on property:persist.gammargb.control=on && property:sys.screen.state=on
    write /dev/kmsg "JOYRC: persist.gammargb.control=on && screen=on"
    start led_control_screen_on

# Symmetric trigger: screen turns on while control is already on
on property:sys.screen.state=on && property:persist.gammargb.control=on
    write /dev/kmsg "JOYRC: screen=on && persist.gammargb.control=on"
    start led_control_screen_on
