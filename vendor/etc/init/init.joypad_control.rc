service led_control_screen_on /system/bin/sh -c "echo 0 > /sys/class/leds/aw20036_led_l/hwen; echo 0 > /sys/class/leds/aw20036_led_r/hwen; sleep 1; /vendor/bin/gammargb --y-red=1.0 --y-green=0.3 --gain-r=2.0"
    class main
    user root
    group root system
    oneshot
    disabled

service led_control_off /system/bin/sh -c "echo 0 > /sys/class/leds/aw20036_led_l/hwen; echo 0 > /sys/class/leds/aw20036_led_r/hwen"
    class main
    user root
    group root system
    oneshot
    disabled

on property:sys.boot_completed=1
    setprop sys.screen.state on

on property:persist.gammargb.control=off
    stop led_control_screen_on
    start led_control_off

on property:sys.screen.state=off
    stop led_control_screen_on
    start led_control_off

on property:persist.gammargb.control=on && property:sys.screen.state=on
    start led_control_screen_on
