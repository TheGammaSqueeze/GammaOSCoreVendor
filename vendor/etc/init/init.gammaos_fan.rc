# /vendor/etc/init/init.gammaos_fan.rc

service setfan_max /vendor/bin/setfan_max.sh
    class main
    user root
    group root system
    seclabel u:r:gammargb:s0
    oneshot
    disabled

service setfan_cool /vendor/bin/setfan_cool.sh
    class main
    user root
    group root system
    seclabel u:r:gammargb:s0
    oneshot
    disabled

service setfan_off /vendor/bin/setfan_off.sh
    class main
    user root
    group root system
    seclabel u:r:gammargb:s0
    oneshot
    disabled

service setfan_auto /vendor/bin/setfan_auto_daemon
    class main
    user root
    group root system
    seclabel u:r:gammargb:s0
    disabled

on property:sys.screen.state=on && property:persist.gammaos.fan_mode=max
    stop setfan_auto
    start setfan_max

on property:sys.screen.state=on && property:persist.gammaos.fan_mode=cool
    stop setfan_auto
    start setfan_cool

on property:sys.screen.state=on && property:persist.gammaos.fan_mode=off
    stop setfan_auto
    start setfan_off

on property:sys.screen.state=on && property:persist.gammaos.fan_mode=auto
    start setfan_auto

on property:sys.screen.state=off
   stop setfan_auto
   start setfan_off
