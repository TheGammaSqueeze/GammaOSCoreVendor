# MTK project .rc configure

on init
    mkdir /mnt/media_rw/usbotg 0700 media_rw media_rw
    mkdir /storage/usbotg 0700 root root

on post-fs-data

#Camera
    chmod 0660 /dev/MAINAF
    chown system camera /dev/MAINAF

    chmod 0660 /dev/MAINAF2
    chown system camera /dev/MAINAF2

    chmod 0660 /dev/SUBAF
    chown system camera /dev/SUBAF

    chmod 0660 /dev/GAF001AF
    chown system camera /dev/GAF001AF

    chmod 0660 /dev/DW9714AF
    chown system camera /dev/DW9714AF

    chmod 0660 /dev/LC898212AF
    chown system camera /dev/LC898212AF

    chmod 0660 /dev/BU64745GWZAF
    chown system camera /dev/BU64745GWZAF

#SMB
    chown system system /proc/smb/ScreenComm
    chmod 0660 /proc/smb/ScreenComm

    chmod 0660 /dev/spm
    chown system system /dev/spm


#aw2033 rgb leds
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/sync_mode
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/orange_red
	
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/brightness
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/led_time
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/blink
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/trigger
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/trigger
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/blink
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/led_time
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/brightness

	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/sync_mode	
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/red/orange_red
	
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/brightness
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/led_time
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/blink
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/trigger
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/trigger
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/blink
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/led_time
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/green/brightness	

	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/brightness
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/led_time
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/blink
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/trigger
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/led_on
	chown system system  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/led_off
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/trigger
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/blink
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/led_time
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/brightness
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/led_on
	chmod  0777  /sys/bus/i2c/drivers/aw2033_led/6-0045/leds/blue/led_off

# fan-controller
	chmod 0777  /sys/devices/platform/odm/odm:fan_controller/fpower
	chmod 0777  /sys/devices/platform/odm/odm:fan_controller/duty
	chmod 0664  /sys/devices/platform/odm/odm:fan_controller/rpm
	chmod 0777  /sys/devices/platform/odm/odm:fan-controller/fan_charger_enable
	chmod 0777  /sys/devices/platform/odm/odm:fan-controller/charger_duty
	chmod 0777  /sys/devices/platform/odm/odm:fan_controller/preset_duty
	chown system system  /sys/devices/platform/odm/odm:fan_controller/fan_charger_enable
	chown system system  /sys/devices/platform/odm/odm:fan_controller/charger_duty
	chown system system  /sys/devices/platform/odm/odm:fan_controller/fpower
	chown system system  /sys/devices/platform/odm/odm:fan_controller/duty
	chown system system  /sys/devices/platform/odm/odm:fan_controller/preset_duty

# dual speaker
    chmod 0777 /sys/devices/platform/sound/spk_en
	chmod 0777 /sys/devices/platform/sound/spk_mode
	chown system system /sys/devices/platform/sound/spk_en
	chown system system /sys/devices/platform/sound/spk_mode

# vibrator voltage_level
	chmod 0777  /sys/class/leds/vibrator/voltage_level
	chmod 0777 /sys/class/leds/vibrator/vibrator_switch
	chown system system  /sys/class/leds/vibrator/voltage_level
	chown system system  /sys/class/leds/vibrator/vibrator_switch
	
on init
    # Refer to http://source.android.com/devices/tech/storage/index.html
    # It said, "Starting in Android 4.4, multiple external storage devices are surfaced to developers through
    #           Context.getExternalFilesDirs(), Context.getExternalCacheDirs(), and Context.getObbDirs().
    #           External storage devices surfaced through these APIs must be a semi-permanent part of the device (such as an SD card slot in a battery compartment).
    #           Developers expect data stored in these locations to be available over long periods of time."
    # Therefore, if the target doesn't support sd hot-plugging (Ex: the SD card slot in a battery compartment), we need to export SECONDARY_STORAGE in 'boot' section
    #
    # export SECONDARY_STORAGE /storage/sdcard1

service fuse_usbotg /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/usbotg /storage/usbotg
    class late_start
    disabled


