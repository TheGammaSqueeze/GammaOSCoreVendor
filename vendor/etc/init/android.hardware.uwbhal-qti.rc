service vendor.uwb-qti /vendor/bin/hw/android.hardware.uwb@service-qti
    class hal
    user uwb
    group uwb system net_bt wakelock oem_2912
    capabilities BLOCK_SUSPEND

on early-init
    # SE Vendor is Thales
    setprop ro.gms.dck.se_capability 1

    # CCC DCK features set is WCC3
    setprop ro.gms.dck.eligible_wcc 3

on post-fs-data
    mkdir /data/vendor/uwb 0770 uwb uwb
