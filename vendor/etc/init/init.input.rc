on property:sys.boot_completed=1
    #inmod tp module
    insmod /vendor/lib/modules/init-input.ko
    insmod /vendor_dlkm/lib/modules/hynitron.ko
    insmod /vendor/lib/modules/hall_sensor.ko
	insmod /vendor_dlkm/lib/modules/sunxi-vibrator.ko
	chmod 0666 /sys/class/vibrator/on
	insmod /vendor_dlkm/lib/modules/gpio_keys_polled1.ko
    chown system system /sys/class/ctp/tp_idle
    chmod 0660 /sys/class/ctp/tp_idle
