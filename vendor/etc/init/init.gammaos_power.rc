service setclock_max /vendor/bin/setclock_max.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_stock /vendor/bin/setclock_stock.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_powersave /vendor/bin/setclock_powersave.sh
    class main
    user root
    group root system
    oneshot
    disabled

on property:persist.gammaos.performance_mode=max
    start setclock_max

on property:persist.gammaos.performance_mode=stock
    start setclock_stock

on property:persist.gammaos.performance_mode=powersave
    start setclock_powersave

on property:sys.screen.state=off
    start setclock_powersave

on property:persist.gammaos.performance_mode=max && property:sys.screen.state=on
    start setclock_max

on property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on
    start setclock_stock

on property:persist.gammaos.performance_mode=powersave && property:sys.screen.state=on
    start setclock_powersave

# Ultra low power sleep (persist.gammaos.ultra_low_power_saving_mode, the nano "Ultra Low Power
# Saving" setting): with the screen off and no USB connected, force the SoC to suspend through
# /vendor/bin/sleep.sh (trimmed wakeup sources, suspend request every 10 s). Screen on, a USB
# connection or a charger stops it and wake.sh restores the stock wakeup sources. Same shape as
# the RG DS power rc.
service cpu_screen_off /vendor/bin/sleep.sh
    class main
    user root
    group root system
    oneshot
    disabled

service cpu_screen_on /vendor/bin/wake.sh
    class main
    user root
    group root system
    oneshot
    disabled
    priority -20
    writepid /dev/cpuset/top-app/tasks

service force_sleep /system/bin/sh -c "sleep 5; start cpu_screen_off;"
    class main
    user root
    group root system
    oneshot
    disabled

service force_wake /system/bin/sh -c "for i in 1 2 3 4 5; do start cpu_screen_on; sleep 1; done"
    class main
    user root
    group root system
    oneshot
    disabled
    priority -20
    writepid /dev/cpuset/top-app/tasks

on property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=1 && property:sys.gammaos.usb.connected=0 && property:sys.boot_completed=1
    stop force_wake
    start force_sleep

on property:sys.screen.state=on
    stop force_sleep
    stop cpu_screen_off
    start force_wake

on property:debug.tracing.battery_stats.charging=1
    stop force_sleep
    stop cpu_screen_off
    start force_wake

on property:sys.gammaos.usb.connected=1
    stop force_sleep
    stop cpu_screen_off
    start force_wake
