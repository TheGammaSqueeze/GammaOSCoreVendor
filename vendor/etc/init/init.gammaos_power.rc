# Silence high-frequency logcat spam from two chronic sources. Also set
# in vendor/build.prop, but duplicated here so the thresholds land before
# any vendor service starts logging (build.prop is read later in boot).
# HWC2: Rockchip HWC3 HAL returns a bogus layer ID 0 in getDisplayRequests
# every composition; SurfaceFlinger logs E/HWC2 at ~60 Hz with no signal.
# allocator-V1-service: gralloc prints four D/I lines per alloc; gammargb
# follow-mode samples at persist.gammaos.rgb.fps Hz with a 64x64 buffer.
on early-init
    setprop log.tag.HWC2 S
    setprop log.tag.android.hardware.graphics.allocator-V1-service S

service setclock_max /vendor/bin/setclock_max.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_stock /vendor/bin/setclock_stock.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_powersave /vendor/bin/setclock_powersave.sh
    class main
    user root
    group root system
    oneshot
    disabled

# Long-running watchdog: reconciles GPU power_policy every 5s and
# re-fires setclock_max via init when a stuck-at-1000 MHz PLL state is
# suspected (power_policy drift under max mode implies a possible
# power-gate resume that re-sticks the PLL; see rk3576_gpu_stuck_state).
# Debounces across the Quick Settings tile's powersave->stock->max
# sweep so transient modes don't trigger a bounce.
service power_watchdog /vendor/bin/power_watchdog.sh
    class main
    user root
    group root system
    disabled

# Delayed re-fire wrappers. Framework services (PowerAIDL, cpuset init,
# scheduling policy HAL) continue writing cpufreq/devfreq governors for
# ~15-25 seconds after sys.boot_completed=1, clobbering whatever
# setclock_max/stock set during early boot. These wrappers sleep long
# enough to outlast that activity, then start the real service.
service setclock_max_delayed /system/bin/sh -c "sleep 30; start setclock_max"
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_stock_delayed /system/bin/sh -c "sleep 30; start setclock_stock"
    class main
    user root
    group root system
    oneshot
    disabled

service cpu_screen_off /vendor/bin/sleep.sh
    class main
    user root
    group root system
    oneshot
    disabled

service cpu_screen_on /system/bin/sh -c "echo none > /sys/class/leds/battery_charging/trigger;"
    class main
    user root
    group root system
    oneshot
    disabled
    priority -20
    writepid /dev/cpuset/top-app/tasks

service force_sleep /system/bin/sh -c "echo heartbeat > /sys/class/leds/battery_charging/trigger; sleep 5; echo none > /sys/class/leds/battery_charging/trigger; start cpu_screen_off;"
    class main
    user root
    group root system
    oneshot
    disabled

service force_wake /system/bin/sh -c "for i in 1 2 3 4 5; do start cpu_screen_on; sleep 1; done"
    class main
    user root
    group root system
    oneshot
    disabled
    priority -20
    writepid /dev/cpuset/top-app/tasks

on property:persist.gammaos.performance_mode=max && property:sys.screen.state=on
    stop setclock_stock
    stop setclock_stock_delayed
    stop setclock_powersave
    stop setclock_max_delayed
    start setclock_max

on property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on
    stop setclock_max
    stop setclock_max_delayed
    stop setclock_powersave
    stop setclock_stock_delayed
    start setclock_stock

on property:persist.gammaos.performance_mode=powersave && property:sys.screen.state=on
    stop setclock_max
    stop setclock_max_delayed
    stop setclock_stock
    stop setclock_stock_delayed
    start setclock_powersave

# Re-fire the active setclock script ~30 seconds after boot_completed.
# By then PowerAIDL has finished registering and the framework has stopped
# overwriting cpufreq/devfreq governors, so our settings stick.
on property:sys.boot_completed=1 && property:persist.gammaos.performance_mode=max
    start setclock_max_delayed

on property:sys.boot_completed=1 && property:persist.gammaos.performance_mode=stock
    start setclock_stock_delayed

on property:sys.boot_completed=1
    start power_watchdog

#on property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=1 && property:debug.tracing.battery_stats.charging=0
#    start setclock_powersave
#    stop force_wake
#    start force_sleep

#on property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=1 && property:debug.tracing.battery_stats.charging=
#    start setclock_powersave
#    stop force_wake
#    start force_sleep

on property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=1 && property:sys.gammaos.usb.connected=0
    stop setclock_max
    stop setclock_max_delayed
    stop setclock_stock
    stop setclock_stock_delayed
    start setclock_powersave
    stop force_wake
    start force_sleep

on property:sys.screen.state=off
    stop setclock_max
    stop setclock_max_delayed
    stop setclock_stock
    stop setclock_stock_delayed
    start setclock_powersave

on property:sys.screen.state=on
    stop force_sleep
    stop cpu_screen_off
    start force_wake

#on property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=0
#    start cpu_screen_off

on property:debug.tracing.battery_stats.charging=1
    stop force_sleep
    start force_wake

on property:sys.gammaos.usb.connected=1
    stop force_sleep
    start force_wake
