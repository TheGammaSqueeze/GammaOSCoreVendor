service setclock_max /vendor/bin/setclock_max.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_stock /vendor/bin/setclock_stock.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_powersave /vendor/bin/setclock_powersave.sh
    class main
    user root
    group root system
    oneshot
    disabled

# restart, not start: each policy script runs for 20 s (and longer under load), and init
# ignores a start for a oneshot that is still running. A sleep and wake inside that window
# left the wake's start dropped, the screen-off loop kept the clocks at their lowest point
# and the device stayed laggy with audio underruns until the next mode change.
on property:persist.gammaos.performance_mode=max
    restart setclock_max

on property:persist.gammaos.performance_mode=stock
    restart setclock_stock

on property:persist.gammaos.performance_mode=powersave
    restart setclock_powersave

on property:sys.screen.state=off
    restart setclock_powersave

on property:persist.gammaos.performance_mode=max && property:sys.screen.state=on
    restart setclock_max

on property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on
    restart setclock_stock

on property:persist.gammaos.performance_mode=powersave && property:sys.screen.state=on
    restart setclock_powersave

# Ultra low power sleep (persist.gammaos.ultra_low_power_saving_mode, the nano "Ultra Low Power
# Saving" setting): with the screen off, no USB data link and no charger, force the SoC to
# suspend through /vendor/bin/sleep.sh (radios off, trimmed wakeup sources, every suspend
# verified and logged in /data/vendor/gammaos/sleep.log). Screen on, USB or a charger stop it
# and wake.sh restores the radios and the stock wakeup sources. debug.tracing.plug_type is
# BatteryService's plug state (0 none, 1 AC, 2 USB, 4 wireless, 8 dock) and is written on
# every build type at once; debug.tracing.battery_stats.charging is not a plug signal (it is
# deferred up to 15 minutes of awake time), so it is not used.
service cpu_screen_off /vendor/bin/sleep.sh
    class main
    user root
    group root system
    oneshot
    disabled

service cpu_screen_on /vendor/bin/wake.sh
    class main
    user root
    group root system
    oneshot
    disabled
    priority -20
    writepid /dev/cpuset/top-app/tasks

service force_sleep /vendor/bin/force_sleep.sh
    class main
    user root
    group root system
    oneshot
    disabled

service force_wake /system/bin/sh -c "for i in 1 2 3 4 5; do start cpu_screen_on; sleep 1; done"
    class main
    user root
    group root system
    oneshot
    disabled
    priority -20
    writepid /dev/cpuset/top-app/tasks

# Also re-arms the sleep when the cable is pulled with the screen still off (plug_type -> 0).
on property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=1 && property:sys.gammaos.usb.connected=0 && property:debug.tracing.plug_type=0 && property:sys.boot_completed=1
    stop cpu_screen_on
    stop force_wake
    start force_sleep

on property:sys.screen.state=on
    stop force_sleep
    stop cpu_screen_off
    start force_wake

on property:sys.gammaos.usb.connected=1
    stop force_sleep
    stop cpu_screen_off
    start force_wake

on property:debug.tracing.plug_type=1
    stop force_sleep
    stop cpu_screen_off
    start force_wake

on property:debug.tracing.plug_type=2
    stop force_sleep
    stop cpu_screen_off
    start force_wake

on property:debug.tracing.plug_type=4
    stop force_sleep
    stop cpu_screen_off
    start force_wake

on property:debug.tracing.plug_type=8
    stop force_sleep
    stop cpu_screen_off
    start force_wake
