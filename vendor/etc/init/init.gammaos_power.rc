service setclock_max /vendor/bin/setclock_max.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_stock /vendor/bin/setclock_stock.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_powersave /vendor/bin/setclock_powersave.sh
    class main
    user root
    group root system
    oneshot
    disabled

service cpu_screen_off /vendor/bin/sleep.sh
    class main
    user root
    group root system wifi inet net_bt_admin net_bt bluetooth
    oneshot
    disabled

# Re-enable only the radios cpu_screen_off (sleep.sh) turned off, restoring the
# user's prior state. Started on screen-on / USB / charging. No-op otherwise.
service ulps_restore_radios /vendor/bin/sleep.sh restore
    class main
    user root
    group root system wifi inet net_bt_admin net_bt bluetooth
    oneshot
    disabled

service cpu_screen_on /system/bin/sh -c "echo 1 | tee /sys/devices/system/cpu/cpu[1-7]/online >/dev/null"
    class main
    user root
    group root system
    oneshot
    disabled

on property:sys.screen.state=off
    start setclock_powersave

on property:persist.gammaos.ultra_low_power_saving_mode=1 && property:sys.screen.state=off
    start cpu_screen_off

# End the ultra-low-power suspend loop and restore radios when the screen comes
# back on, USB is connected, or the device starts charging.
on property:sys.screen.state=on
    stop cpu_screen_off
    start ulps_restore_radios

on property:sys.gammaos.usb.connected=1
    stop cpu_screen_off
    start ulps_restore_radios

on property:debug.tracing.battery_stats.charging=1
    stop cpu_screen_off
    start ulps_restore_radios

on property:persist.gammaos.performance_mode=max && property:sys.screen.state=on
    start setclock_max
    start cpu_screen_on

on property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on
    start setclock_stock
    start cpu_screen_on

on property:persist.gammaos.performance_mode=powersave && property:sys.screen.state=on
    start setclock_powersave
    start cpu_screen_on
