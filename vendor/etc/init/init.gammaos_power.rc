service setclock_max /vendor/bin/setclock_max.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_stock /vendor/bin/setclock_stock.sh
    class main
    user root
    group root system
    oneshot
    disabled

service setclock_powersave /vendor/bin/setclock_powersave.sh
    class main
    user root
    group root system
    oneshot
    disabled

service cpu_screen_off /system/bin/sh -c "echo 0 | tee /sys/devices/system/cpu/cpu[1-7]/online >/dev/null; echo mem > /sys/power/state"
    class main
    user root
    group root system
    oneshot
    disabled

service cpu_screen_on /system/bin/sh -c "echo 1 | tee /sys/devices/system/cpu/cpu[1-7]/online >/dev/null"
    class main
    user root
    group root system
    oneshot
    disabled

on property:sys.screen.state=off
    start setclock_powersave

on property:persist.gammaos.ultra_low_power_saving_mode=1 && property:sys.screen.state=off
    start cpu_screen_off

on property:persist.gammaos.performance_mode=max && property:sys.screen.state=on
    start setclock_max
    start cpu_screen_on

on property:persist.gammaos.performance_mode=stock && property:sys.screen.state=on
    start setclock_stock
    start cpu_screen_on

on property:persist.gammaos.performance_mode=powersave && property:sys.screen.state=on
    start setclock_powersave
    start cpu_screen_on
