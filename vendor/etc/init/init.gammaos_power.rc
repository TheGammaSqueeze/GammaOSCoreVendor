# /vendor/etc/init/init.gammaos_power.rc

service setclock_max /vendor/bin/setclock_max.sh
    class main
    user root
    group root system
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

service setclock_stock /vendor/bin/setclock_stock.sh
    class main
    user root
    group root system
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

service setclock_powersave /vendor/bin/setclock_powersave.sh
    class main
    user root
    group root system
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

service cpu_screen_off /vendor/bin/sleep.sh
    class main
    user root
    group root system wifi inet net_bt_admin net_bt bluetooth
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

# Re-enable the radios that cpu_screen_off turned off, restoring only the ones the
# user actually had on. Started whenever the ultra-low-power suspend ends (screen
# on, USB plugged, or charging). No-op if nothing was turned off.
service ulps_restore_radios /vendor/bin/sleep.sh restore
    class main
    user root
    group root system wifi inet net_bt_admin net_bt bluetooth
    seclabel u:r:gammaoscustomization:s0
    oneshot
    disabled

on property:sys.screen.state=off && property:persist.gammaos.ultra_low_power_saving_mode=1 && property:sys.gammaos.usb.connected=0
    start cpu_screen_off

on property:sys.screen.state=on
    stop cpu_screen_off
    start ulps_restore_radios

on property:debug.tracing.battery_stats.charging=1
    stop cpu_screen_off
    start ulps_restore_radios

on property:sys.gammaos.usb.connected=1
    stop cpu_screen_off
    start ulps_restore_radios

on property:persist.gammaos.performance_mode=max
    start setclock_max

on property:persist.gammaos.performance_mode=stock
    start setclock_stock

on property:persist.gammaos.performance_mode=powersave
    start setclock_powersave

