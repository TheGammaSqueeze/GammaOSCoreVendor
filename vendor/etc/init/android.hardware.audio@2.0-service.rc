service vendor.audio-hal-2-0 /vendor/bin/hw/android.hardware.audio@2.0-service
    class hal
    user audioserver
    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct wakelock
    capabilities BLOCK_SUSPEND
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks /dev/stune/foreground/tasks
    # Do NOT mark oneshot: the ceres audio HAL can SIGABRT under the GSI scudo
    # allocator (double-free in the output-standby / pcm_close path). oneshot would
    # leave it unregistered, blocking AudioService ~65s, which trips the system_server
    # watchdog and tears down the emulated FUSE mount during the first-boot wipe/setup
    # (killing /sdcard). Letting init respawn it (re-registers in ~1s) avoids that.
    interface android.hardware.audio@4.0::IDevicesFactory default
    interface android.hardware.audio@2.0::IDevicesFactory default
