# Nano mode (sys.gammaos.minimal_boot=1) starts class main but not late_start,
# which keeps the DRM home light. Wi-Fi needs cnss-daemon (class late_start in
# hw/init.qcom.rc) for the firmware and QMI side; without it the cld driver
# never completes its configuration and Wi-Fi cannot be enabled.
on property:sys.gammaos.minimal_boot=1
    start cnss-daemon

# Backlight ranges for split brightness, read from the panels (see
# gammaos_backlight_props.sh).
service vendor.gammaos_backlight_props /vendor/bin/gammaos_backlight_props.sh
    class core
    user root
    group root system
    oneshot
    disabled

on post-fs
    start vendor.gammaos_backlight_props

# Touch report rate: both FocalTech controllers (top fts_ts, bottom fts_ts_sec) run
# at 120 Hz by default (register 0x88 = 12). 0x18 asks for 240 Hz; the controllers
# top out at ~182 Hz (5.5 ms between reports, measured), a third less sampling delay
# than 120 Hz for every touch reader. The driver keeps the value across suspend and
# applies it again on resume. fts_report_rate takes a hex value.
on boot
    write /sys/devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/880000.i2c/i2c-8/8-0038/fts_report_rate 18
    write /sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a98000.i2c/i2c-6/6-0038/fts_report_rate 18
