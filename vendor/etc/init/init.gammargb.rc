service gammargb /vendor/bin/gammargb
    class main
    user root
    group root system
    seclabel u:r:su:s0
    oneshot
    disabled

service led_off /vendor/bin/gammargb --off
    class main
    user root
    group root system
    seclabel u:r:su:s0
    oneshot
    disabled

on property:persist.gammaos.rgb.enable=1
    start gammargb

on property:persist.gammaos.rgb.enable=0
    stop gammargb
    start led_off

on property:sys.boot_completed=1
    start gammargb
